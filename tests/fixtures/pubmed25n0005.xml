          </JournalIssue>
          <Title>Nature</Title>
        </Journal>
        <ArticleTitle>Edge cases for ordering columns.</ArticleTitle>
        <AuthorList CompleteYN="Y">
          <Author ValidYN="Y">
            <LastName>First</LastName>
            <ForeName>Ada</ForeName>
